{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutter",
  "version": "0.1.0",
  "identifier": "com.femimeduna.mutter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pill",
        "title": "Mutter",
        "url": "pill/index.html",
        "width": 220,
        "height": 44,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "dashboard",
        "title": "Mutter",
        "url": "dashboard/index.html",
        "width": 720,
        "height": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "recovery",
        "title": "Mutter",
        "url": "recovery/index.html",
        "width": 460,
        "height": 440,
        "resizable": false,
        "decorations": true,
        "transparent": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": null,
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
